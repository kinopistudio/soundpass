extends Node
## Sound effect player for packs generated by soundpass (Godot 4).
##
## Setup: render the pack into res://audio/soundpass, then add this script as an
## Autoload named "SoundPass" (Project Settings > Globals > Autoload).
## For exported builds, add *.json to Export > Resources > "Filters to export non-resource files".
##
## Usage:
##   SoundPass.play("coin")
##   SoundPass.play("combo", combo_count - 1)   # ladder sounds
##   SoundPass.play("hit", 0, -6.0)            # 6 dB quieter
##   SoundPass.bus = "SFX"                      # route into your SFX bus

const FOLDER := "res://audio/soundpass"
const VOICES := 16
const REPEAT_GUARD_MS := 30

var bus: StringName = &"Master"
var volume_db := 0.0
var muted := false

var _clips := {}
var _ladder := {}
var _last_variant := {}
var _last_played := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0


func _ready() -> void:
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	var f := FileAccess.open(FOLDER + "/manifest.json", FileAccess.READ)
	if f == null:
		push_warning("SoundPass: %s/manifest.json not found. Did you run `soundpass pack`?" % FOLDER)
		return
	var manifest = JSON.parse_string(f.get_as_text())
	if typeof(manifest) != TYPE_DICTIONARY:
		push_warning("SoundPass: could not parse manifest.json")
		return
	for s in manifest["sounds"]:
		var arr: Array[AudioStream] = []
		for file in s["files"]:
			arr.append(load(FOLDER + "/" + file))
		_clips[s["id"]] = arr
		_ladder[s["id"]] = s.get("ladder", false)


func has(id: String) -> bool:
	return _clips.has(id)


## Play a sound by id. `level` picks the step of a ladder sound (combo, star).
func play(id: String, level: int = 0, volume_offset_db: float = 0.0, pitch_jitter: float = 0.03) -> void:
	if muted:
		return
	if not _clips.has(id):
		push_warning("SoundPass: no sound '%s'" % id)
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(id, -100000)) < REPEAT_GUARD_MS:
		return
	_last_played[id] = now

	var arr: Array = _clips[id]
	var ladder: bool = _ladder[id]
	var idx := 0
	if ladder:
		idx = clampi(level, 0, arr.size() - 1)
	else:
		idx = randi() % arr.size()
		if arr.size() > 1 and _last_variant.get(id, -1) == idx:
			idx = (idx + 1) % arr.size()
		_last_variant[id] = idx

	var p := _players[_next]
	_next = (_next + 1) % VOICES
	p.stream = arr[idx]
	p.bus = bus
	p.volume_db = volume_db + volume_offset_db
	p.pitch_scale = 1.0 if ladder else randf_range(1.0 - pitch_jitter, 1.0 + pitch_jitter)
	p.play()
